#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

command -v git-lfs >/dev/null 2>&1 || {
    echo "This repository requires Git LFS before pushing." >&2
    echo "Install it with: brew install git-lfs" >&2
    exit 2
}

if ! command -v xcodegen >/dev/null 2>&1; then
    echo "XcodeGen is required before pushing." >&2
    echo "Install it with: brew install xcodegen" >&2
    exit 1
fi

if [ ! -e JabTracker/Resources/usda_foods.sqlite ]; then
    echo "The food database is missing at JabTracker/Resources/usda_foods.sqlite." >&2
    echo "Prepare the local database before pushing." >&2
    exit 1
fi

echo "Checking generated Xcode project..."
xcodegen generate
git diff --check
if ! git diff --quiet -- JabTracker.xcodeproj; then
    echo "Generated project is out of date. Review and commit JabTracker.xcodeproj." >&2
    exit 1
fi

echo "Running Python tooling tests..."
env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
    python3 -m unittest discover -s scripts/tests -p 'test_*.py'

echo "Running unit tests..."
./scripts/test.sh unit --no-log

git lfs pre-push "$@"
