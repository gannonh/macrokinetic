#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged_files" ] || exit 0

git diff --cached --check

swift_files=$(printf '%s\n' "$staged_files" | grep '\.swift$' || true)
if [ -n "$swift_files" ]; then
    if ! command -v swiftlint >/dev/null 2>&1; then
        echo "SwiftLint is required for commits containing Swift changes." >&2
        echo "Install it with: brew install swiftlint" >&2
        exit 1
    fi

    swiftlint lint --quiet --force-exclude $swift_files
fi

if printf '%s\n' "$staged_files" | grep -q '\.py$'; then
    python3 -m compileall -q scripts
fi
