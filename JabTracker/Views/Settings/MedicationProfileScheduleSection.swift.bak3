import SwiftData
import SwiftUI

/// Schedule management section for MedicationProfileDetailView
struct MedicationProfileScheduleSection: View {
    let viewModel: MedicationProfileViewModel

    var body: some View {
        Group {
            doseScheduleSection
            scheduleHistorySection
        }
    }

    // MARK: - Dose Schedule Section

    @ViewBuilder
    private var doseScheduleSection: some View {
        DesignCard {
            VStack(alignment: .leading, spacing: 16) {
                Text("Dose Schedule")
                    .font(DesignTokens.Typography.headline)

                if let schedule = viewModel.activeSchedule {
                    scheduleContent(schedule: schedule)
                } else {
                    noScheduleContent
                }
            }
        }
    }

    @ViewBuilder
    private func scheduleContent(schedule: DoseSchedule) -> some View {
        // Current schedule summary - convert schedule to individual parameters
        ScheduleSummaryView(
            patternType: schedule.pattern,
            frequency: frequencyDescription(for: schedule),
            nextDose: nextScheduledDose(for: schedule),
            reminderMinutes: schedule.baseSchedule.reminderMinutesBefore,
            isPaused: schedule.pausedAt != nil,
            titrationWarning: nil, // TODO: Implement titration warning logic
            onTitrationWarningTap: {
                viewModel.showDoseTitration = true
            }
        )

        Divider()

        // Schedule actions
        VStack(spacing: 12) {
            scheduleEditButton
            Divider()

            if schedule.isActive {
                pauseScheduleButton
            } else {
                resumeScheduleButton
            }

            Divider()
            deactivateScheduleButton
        }
    }

    // MARK: - Helper Methods

    private func frequencyDescription(for schedule: DoseSchedule) -> String {
        switch schedule.pattern {
        case .weekly:
            return "Once weekly"
        case .splitDose:
            return "Twice daily"
        case .custom:
            return "Custom schedule"
        }
    }

    private func nextScheduledDose(for schedule: DoseSchedule) -> Date? {
        // Calculate next dose from current time
        // For now, return nil - this will be computed by ScheduleService in integration
        return nil
    }

    @ViewBuilder
    private var noScheduleContent: some View {
        Button {
            viewModel.showScheduleEditSheet = true
        } label: {
            HStack {
                Label("Create Dose Schedule", systemImage: "calendar.badge.plus")
                Spacer()
                Image(systemName: "chevron.right")
                    .foregroundColor(.secondary)
                    .font(.caption)
            }
        }
        .accessibilityIdentifier("create-schedule-button")
        .buttonStyle(.plain)
        .foregroundColor(.primary)
    }

    // MARK: - Action Buttons

    @ViewBuilder
    private var scheduleEditButton: some View {
        Button {
            viewModel.showScheduleEditSheet = true
        } label: {
            HStack {
                Label("Edit Schedule", systemImage: "calendar.badge.clock")
                Spacer()
                Image(systemName: "chevron.right")
                    .foregroundColor(.secondary)
                    .font(.caption)
            }
        }
        .accessibilityIdentifier("edit-schedule-button")
        .buttonStyle(.plain)
        .foregroundColor(.primary)
    }

    @ViewBuilder
    private var pauseScheduleButton: some View {
        Button {
            viewModel.showPauseScheduleSheet = true
        } label: {
            HStack {
                Label("Pause Schedule", systemImage: "pause.circle")
                    .foregroundColor(.orange)
                Spacer()
                Image(systemName: "chevron.right")
                    .foregroundColor(.secondary)
                    .font(.caption)
            }
        }
        .accessibilityIdentifier("pause-schedule-button")
        .buttonStyle(.plain)
    }

    @ViewBuilder
    private var resumeScheduleButton: some View {
        Button {
            Task {
                viewModel.resumeSchedule()
            }
        } label: {
            HStack {
                Label("Resume Schedule", systemImage: "play.circle")
                    .foregroundColor(.green)
                Spacer()
                Image(systemName: "chevron.right")
                    .foregroundColor(.secondary)
                    .font(.caption)
            }
        }
        .accessibilityIdentifier("resume-schedule-button")
        .buttonStyle(.plain)
    }

    @ViewBuilder
    private var deactivateScheduleButton: some View {
        Button(role: .destructive) {
            viewModel.showDeactivateConfirmation = true
        } label: {
            HStack {
                Label("Deactivate Schedule", systemImage: "trash")
                Spacer()
                Image(systemName: "chevron.right")
                    .foregroundColor(.secondary)
                    .font(.caption)
            }
        }
        .accessibilityIdentifier("deactivate-schedule-button")
        .buttonStyle(.plain)
    }

    // MARK: - Schedule History Section

    @ViewBuilder
    private var scheduleHistorySection: some View {
        if !viewModel.scheduleHistory.isEmpty {
            DesignCard {
                VStack(alignment: .leading, spacing: 16) {
                    Text("Schedule History")
                        .font(DesignTokens.Typography.headline)

                    VStack(spacing: 8) {
                        ForEach(Array(viewModel.scheduleHistory.enumerated()), id: \.element.id) { index, historyItem in
                            ScheduleHistoryRow(item: historyItem)
                            if index < viewModel.scheduleHistory.count - 1 {
                                Divider()
                            }
                        }
                    }
                }
            }
        }
    }
}
