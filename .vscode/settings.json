{
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.swift$",
        "cmd": "/opt/homebrew/bin/swiftformat ${file}"
      }
    ]
  },
  "files.associations": {
    "*.swift": "swift"
  },
  "swift.formatting.enable": true,
  "terminal.integrated.env.osx": {
    "PATH": "/opt/homebrew/bin:${env:PATH}"
  }
}