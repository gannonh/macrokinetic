# SwiftFormat configuration
--swiftversion 5.8
--indent 4
--indentcase false
--trimwhitespace always
--commas always
--wraparguments preserve
--wrapcollections preserve
--closingparen same-line
--hexliteralcase lowercase
--exponentcase lowercase
--decimalgrouping 3,6
--binarygrouping 4,8
--octalgrouping 4,8
--hexgrouping 4,8
--patternlet hoist
--self insert