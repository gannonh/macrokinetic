{
  "policy": {
    "description": "JabTracker Test Coverage Policy - Tiered approach based on component complexity",
    "tiers": {
      "pure_business_logic": {
        "threshold": 90,
        "description": "Core business logic with minimal framework dependencies",
        "files": [
          "Models/User.swift",
          "Models/Dose.swift",
          "Models/MedicationProfile.swift",
          "Models/Medication.swift",
          "Models/ConcentrationPoint.swift",
          "Models/Medication+Pharmacokinetics.swift",
          "Models/DoseEvent.swift",
          "Models/DoseSchedule.swift",
          "Models/ScheduledDose.swift",
          "Services/PharmacokineticsEngine.swift",
          "Services/ReconstitutionCalculator.swift",
          "Models/DoseTitration.swift",
          "Models/AdherenceStatistics.swift",
          "Models/AdherenceStatistics+Calculations.swift",
          "Models/AdherenceTrendData.swift",
          "Models/AdherencePattern.swift",
          "Models/AdherenceInsight.swift",
          "Utilities/PricingCalculator.swift",
          "Services/ScheduleService+Titration.swift",
          "Models/Food.swift",
          "Models/FoodEntry.swift",
          "Models/FoodSource.swift",
          "Models/MealSection.swift",
          "Models/Food+Serving.swift",
          "Models/WeightEntry.swift",
          "Models/MetricsEntry.swift",
          "Models/ProgressPhoto.swift",
          "Models/ProgramConfiguration.swift",
          "Models/NutritionGoal.swift",
          "Models/NutritionProgram.swift",
          "Models/BiologicalSex.swift"
        ]
      },
      "business_logic_with_logging": {
        "threshold": 75,
        "description": "Core business logic with OSLog logging - implicit closures from string interpolation reduce testable coverage",
        "rationale": "TDEECalculationEngine files have 100% coverage on actual business logic, but OSLog implicit closures (compiler-generated for string interpolation) are inherently untestable and reduce overall line coverage",
        "files": [
          "Services/TDEECalculationEngine.swift",
          "Services/TDEECalculationEngine+EWMA.swift",
          "Services/TDEECalculationEngine+Adaptive.swift",
          "Services/TDEECalculationEngine+Validation.swift"
        ]
      },
      "infrastructure": {
        "threshold": 62,
        "description": "Data management with some framework dependencies",
        "files": [
          "DataController.swift",
          "Models/ChartData.swift",
          "Models/ChartDataEnums.swift",
          "Models/ChartDataTypes.swift",
          "Services/AnalyticsService.swift",
          "Services/ChartDataProcessor+Filtering.swift",
          "Services/ChartDataProcessor+Interpolation.swift",
          "Services/ChartDataProcessor.swift",
          "Services/ChartDatasetCache.swift",
          "Services/ChartDatasetService.swift",
          "Services/DoseDataService.swift",
          "Services/DoseSearchService.swift",
          "Services/DoseService.swift",
          "Services/MedicationManager.swift",
          "Services/NotificationService.swift",
          "Services/NotificationService+Background.swift",
          "Services/NotificationService+Persistence.swift",
          "Services/NotificationService+Reminders.swift",
          "Services/ScheduleService+Adherence.swift",
          "Services/ScheduleService+Modifications.swift",
          "Services/ScheduleService+Projection.swift",
          "Services/ScheduleService.swift",
          "Services/LocalFoodDatabase.swift",
          "Services/OpenFoodFactsService.swift",
          "Services/FoodService.swift",
          "Services/MealLogService.swift",
          "Services/CustomFoodService.swift",
          "Services/MetricsService.swift",
          "Services/ProgressPhotoService.swift",
          "Services/TDEEService.swift",
          "Services/WeeklyCheckInService.swift",
          "Services/CalorieAdjustmentService.swift",
          "Services/CalorieAdjustmentService+Adjustments.swift"
        ]
      },
      "framework_integration": {
        "threshold": 42,
        "description": "Heavy Apple framework dependencies and SwiftUI components with limited testability",
        "files": [
          "BiometricAuthManager.swift",
          "Services/NotificationService+Actions.swift",
          "Services/SubscriptionManager.swift",
          "Services/SubscriptionManager+Testing.swift",
          "Onboarding/OnboardingCoordinator.swift",
          "Onboarding/OnboardingViewModel.swift",
          "Views/Analytics/ConcentrationChartGestureHandler.swift",
          "Views/Analytics/DoseMarkerOverlay.swift"
        ]
      },
      "testing_infrastructure": {
        "threshold": 12,
        "description": "Framework integration files with extensive UI testing infrastructure, Sign in with Apple delegates, and private Apple framework integration code that cannot be unit tested",
        "rationale": "AuthenticationManager.swift (1507 lines) contains: ~500 lines of ASAuthorizationController delegate code (requires real Apple Sign In), ~350 lines of UI testing infrastructure (setupUITestingUser, seedTestDataIfRequested), ~80 lines of data reset code (resetAppData - dangerous to test), and ~200 lines of Keychain operations. Only ~12% of the file (core state management) is realistically unit testable.",
        "files": [
          "AuthenticationManager.swift"
        ]
      },
      "view_models": {
        "threshold": 85,
        "description": "ObservableObject classes with testable business logic",
        "files": [
          "ViewModels/DoseCalendarViewModel.swift",
          "ViewModels/DoseHistoryViewModel.swift",
          "ViewModels/AnalyticsViewModel.swift",
          "ViewModels/FoodSearchSheetViewModel.swift",
          "ViewModels/CreateFoodViewModel.swift",
          "ViewModels/QuickAddViewModel.swift",
          "Views/Analytics/ConcentrationChartState.swift",
          "Views/Dashboard/QuickDoseViewModel.swift",
          "Views/Nutrition/NutritionSummaryViewModel.swift"
        ]
      },
      "utilities": {
        "threshold": 75,
        "description": "Helper functions, extensions, and utility classes",
        "files": [
          "Utils/ProfileValidation.swift",
          "Extensions/Array+Unique.swift",
          "Models/Extensions/Dose+Filtering.swift",
          "Models/PendingNotification.swift",
          "Utilities/DoseValidation.swift",
          "Utilities/DoseDefaults.swift",
          "Utilities/TimeConstants.swift",
          "Utilities/TitrationErrorMessages.swift",
          "Views/Analytics/ConcentrationChartAccessibility.swift",
          "App/AppServices.swift",
          "App/DeeplinkHandler.swift"
        ]
      },
      "swiftui_components": {
        "threshold": 15,
        "description": "SwiftUI view components with minimal testable business logic",
        "files": [
          "Views/Components/ProfileField.swift",
          "Views/Settings/Components/ReminderToggleRow.swift"
        ]
      }
    }
  },
