{
  "policy": {
    "description": "JabTracker Test Coverage Policy - Tiered approach based on component complexity",
    "tiers": {
      "pure_business_logic": {
        "threshold": 90,
        "description": "Core business logic with minimal framework dependencies",
        "files": [
          "Models/User.swift",
          "Models/Dose.swift",
          "Models/MedicationProfile.swift",
          "Models/Medication.swift",
          "Models/ConcentrationPoint.swift",
          "Models/Medication+Pharmacokinetics.swift",
          "Models/DoseEvent.swift",
          "Models/DoseSchedule.swift",
          "Models/ScheduledDose.swift",
          "Services/PharmacokineticsEngine.swift",
          "Services/ReconstitutionCalculator.swift",
          "Models/DoseTitration.swift",
          "Models/AdherenceStatistics.swift",
          "Models/AdherenceTrendData.swift",
          "Models/AdherencePattern.swift",
          "Models/AdherenceInsight.swift",
          "Utilities/PricingCalculator.swift"
        ]
      },
      "infrastructure": {
        "threshold": 62,
        "description": "Data management with some framework dependencies",
        "files": [
          "DataController.swift",
          "Services/MedicationManager.swift",
          "Services/DoseSearchService.swift",
          "Services/DoseService.swift",
          "Services/DoseDataService.swift",
          "Services/ChartDataProcessor.swift",
          "Services/ChartDataProcessor+Filtering.swift",
          "Services/ChartDataProcessor+Interpolation.swift",
          "Services/ChartDatasetService.swift",
          "Services/ChartDatasetCache.swift",
          "Services/AnalyticsService.swift",
          "Models/ChartData.swift",
          "Models/ChartDataTypes.swift",
          "Models/ChartDataEnums.swift"
        ]
      },
      "framework_integration": {
        "threshold": 42,
        "description": "Heavy Apple framework dependencies and SwiftUI components with limited testability",
        "files": [
          "BiometricAuthManager.swift",
          "Services/SubscriptionManager.swift",
          "Services/SubscriptionManager+Testing.swift",
          "Onboarding/OnboardingCoordinator.swift",
          "Views/Analytics/ConcentrationChartGestureHandler.swift",
          "Views/Analytics/DoseMarkerOverlay.swift"
        ]
      },
      "testing_infrastructure": {
        "threshold": 27,
        "description": "Framework integration files with extensive UI testing infrastructure and private Apple framework integration code that cannot be unit tested",
        "rationale": "These files contain significant amounts of UI testing setup code (setupUITestingUser, seedTestDataIfRequested, resetAppData) and private Apple framework integration methods that are inherently difficult or impossible to unit test",
        "files": [
          "AuthenticationManager.swift"
        ]
      },
      "view_models": {
        "threshold": 85,
        "description": "ObservableObject classes with testable business logic",
        "files": [
          "Onboarding/OnboardingViewModel.swift",
          "ViewModels/DoseCalendarViewModel.swift",
          "ViewModels/DoseHistoryViewModel.swift",
          "ViewModels/AnalyticsViewModel.swift",
          "Views/Analytics/ConcentrationChartState.swift",
          "Views/Dashboard/QuickDoseViewModel.swift"
        ]
      },
      "utilities": {
        "threshold": 75,
        "description": "Helper functions, extensions, and utility classes",
        "files": [
          "Utils/ProfileValidation.swift",
          "Extensions/Array+Unique.swift",
          "Models/Extensions/Dose+Filtering.swift",
          "Utilities/DoseValidation.swift",
          "Utilities/DoseDefaults.swift",
          "Views/Analytics/ConcentrationChartAccessibility.swift"
        ]
      },
      "swiftui_components": {
        "threshold": 15,
        "description": "SwiftUI view components with minimal testable business logic",
        "files": [
          "Views/Components/ProfileField.swift"
        ]
      }
    }
  },
  "exclusions": {
    "description": "Files excluded from coverage requirements",
    "categories": [
      "SwiftUI Views",
      "View modifiers",
      "SwiftUI-specific presentation logic",
      "App entry points",
      "Design system components"
    ],
    "files": [
      "Models/SubscriptionProducts.swift",
      "ContentView.swift",
      "JabTrackerApp.swift",
      "Utils/TestDataSeeding.swift",
      "Design/ButtonComponents.swift",
      "Design/ButtonStyles.swift",
      "Design/CardComponents.swift",
      "Design/Colors+Extensions.swift",
      "Design/DesignTokens.swift",
      "Onboarding/Components/OnboardingProgressIndicator.swift",
      "Onboarding/OnboardingView.swift",
      "Onboarding/Views/InitialDoseSetupView.swift",
      "Onboarding/Views/MedicationSelectionView.swift",
      "Onboarding/Views/PermissionsRequestView.swift",
      "Onboarding/Views/SubscriptionView.swift",
      "Onboarding/Views/WelcomeScreensView.swift",
      "Views/Analytics/AdherenceMetricsCard.swift",
      "Views/Analytics/StreakCounterView.swift",
      "Views/Analytics/AdherenceTrendChart.swift",
      "Views/Analytics/MissedDosePatternView.swift",
      "Views/Analytics/AdherenceProgressIndicator.swift",
      "Views/Analytics/ChartConfiguration.swift",
      "Views/Analytics/ChartControlsView.swift",
      "Views/Analytics/ChartExportView.swift",
      "Views/Analytics/ConcentrationChartControls.swift",
      "Views/Analytics/ConcentrationTimelineChart.swift",
      "Views/Analytics/TimePeriodSelector.swift",
      "Views/Analytics/AnalyticsView.swift",
      "Views/AuthenticationView.swift",
      "Views/Dashboard/ConcentrationCard.swift",
      "Views/Dashboard/ConcentrationDisplay.swift",
      "Views/Dashboard/QuickDoseButton.swift",
      "Views/DoseEntry/DoseEntryFormSections.swift",
      "Views/DoseEntry/DoseEntryPhotoSection.swift",
      "Views/DoseEntry/DoseEntryPKSection.swift",
      "Views/DoseEntry/DoseEntrySheet.swift",
      "Views/DoseEntry/QuickDoseEntry.swift",
      "Views/History/CalendarDayView.swift",
      "Views/History/DoseCalendarView.swift",
      "Views/History/DoseDayDetailView.swift",
      "Views/History/DoseHistoryRow.swift",
      "Views/History/DoseHistoryView.swift",
      "Views/History/DoseSearchAndFilterView.swift",
      "Views/History/HistoryView.swift",
      "Views/History/MonthlyStatsView.swift",
      "Views/MedicationProfile/DoseTitrationView.swift",
      "Views/MedicationProfile/ReconstitutionCalculatorView.swift",
      "Views/Settings/MedicationFormComponents.swift",
      "Views/Settings/MedicationProfileSettingsView.swift",
      "Views/Settings/SettingsView.swift",
      "Views/SplashView.swift",
      "Views/UserProfileView.swift"
    ]
  },
  "special_testing_notes": {
    "cloudkit_integration": {
      "description": "CloudKit methods tested via E2E UI tests rather than unit tests",
      "rationale": "CloudKit requires real iCloud account and network connectivity, making unit testing impractical and unreliable",
      "methods_covered_by_e2e": [
        "DataController.checkiCloudStatus()",
        "DataController.checkCloudKitStatus()"
      ],
      "e2e_test_file": "CloudKitIntegrationUITests.swift",
      "unit_test_approach": "Business logic around CloudKit status handling is tested with mocks"
    },
    "authentication_integration": {
      "description": "Real Sign in with Apple tested via E2E, mocked scenarios via unit tests",
      "e2e_test_file": "AuthenticationUITests.swift",
      "test_approach": "Hybrid - E2E for real authentication flows, unit tests for error handling and state management"
    }
  },
  "overall_target": {
    "informational_only": true,
    "note": "Overall coverage percentage is informational due to SwiftUI architecture limitations"
  }
}